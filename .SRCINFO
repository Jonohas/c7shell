pkgbase = c7shell
	pkgdesc = c7shell desktop environment: Hyprland (lua config) with the c7shell Quickshell shell
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/Jonohas/c7shell
	install = c7shell.install
	arch = any
	license = MIT
	license = OFL-1.1
	makedepends = git
	makedepends = lua
	depends = hyprland>=0.56
	depends = quickshell
	depends = hypridle
	depends = hyprlock
	depends = hyprpaper
	depends = hyprpolkitagent
	depends = qt6-declarative
	depends = ttf-jetbrains-mono
	depends = plasma-integration
	depends = breeze
	depends = breeze-icons
	depends = adwaita-cursors
	depends = wireplumber
	depends = networkmanager
	depends = bluez
	depends = bluez-utils
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = grim
	depends = wf-recorder
	depends = wl-clipboard
	depends = libnotify
	depends = xdg-desktop-portal-hyprland
	depends = pacman-contrib
	depends = xdg-utils
	depends = glib2
	depends = desktop-file-utils
	depends = hicolor-icon-theme
	optdepends = kitty: terminal bound to SUPER+Q
	optdepends = dolphin: file manager bound to SUPER+E
	optdepends = hyprlauncher: fallback launcher (the shell provides its own)
	optdepends = ddcutil: DDC/CI backlight control for external monitors
	optdepends = brightnessctl: backlight control for internal panels
	optdepends = upower: battery readout in the bar
	optdepends = playerctl: media keys (XF86Audio{Next,Prev,Play,Pause})
	optdepends = solaar: Logitech device support, autostarted if present
	optdepends = kwallet: secrets service, started by conf/autostart.lua when installed
	optdepends = kwallet-pam: unlocks that wallet with the login password
	optdepends = paru: AUR count in the updates pill
	optdepends = flatpak: flatpak count in the updates pill
	optdepends = fprintd: fingerprint unlock (commented out in hypr/hyprlock.conf)
	optdepends = jq: helper scripting
	source = c7shell::git+https://github.com/Jonohas/c7shell.git#branch=main
	source = space-grotesk-2.0.0.tar.gz::https://github.com/floriankarsten/space-grotesk/archive/refs/tags/2.0.0.tar.gz
	sha256sums = SKIP
	sha256sums = 366da4ddec4f637f6d2d342251c2e5e8b8af67d10653f347a9d9d603cc64547a

pkgname = c7shell
