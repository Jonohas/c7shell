#!/bin/bash
# c7power-root: the only thing the power page runs as root, and the target of
# the io.crimson7.c7shell.power polkit action.
#
# Same trust boundary as c7up-root: pkexec hands root to a *program*, so this
# one takes a fixed verb and validates every argument against a closed set.
# Nothing here forwards argv to a shell, and no verb takes a path from the
# caller -- the three files it writes are named in this script, not by whoever
# invoked it.
#
# Everything else the power page does -- reading the active tuned profile,
# reading the charge limit, rewriting hypridle.conf -- stays unprivileged and
# never comes near this file.
set -euo pipefail

verb=${1-}
shift || true

export LC_ALL=C

die() { printf 'c7power-root: %s\n' "$1" >&2; exit 2; }

case "$verb" in
  # Stop charging at N%, which is the one battery-health control the kernel
  # exposes. Written to every pack the machine has: a two-battery ThinkPad
  # wears both down, and setting one of them is a half-applied setting the UI
  # would then misreport.
  charge-limit)
    n=${1-}
    [[ $n =~ ^[0-9]{1,3}$ ]] || die "not a percentage: $n"
    # Below 50 the firmware on several vendors simply refuses the write, and a
    # limit that low is a mis-drag rather than an intention.
    ((n >= 50 && n <= 100)) || die "charge limit out of range (50-100): $n"
    wrote=0
    for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
      [[ -w $f ]] || continue
      printf '%s\n' "$n" > "$f"
      wrote=1
    done
    ((wrote)) || die 'no pack exposes charge_control_end_threshold'
    ;;

  # The offer the "tuned is not running" card makes. enable --now covers both
  # halves of what that card means: running today, and running tomorrow.
  enable-tuned)
    command -v tuned >/dev/null 2>&1 || die 'tuned is not installed'
    exec systemctl enable --now tuned.service
    ;;

  # What the lid does. logind owns this, and it is system state -- so the
  # settings page edits a drop-in of our own rather than /etc/systemd/logind.conf
  # itself, which is a pacman-managed file with a .pacnew of its own.
  lid-close)
    case "${1-}" in
      suspend|lock|ignore|poweroff|hibernate) action=$1 ;;
      *) die "not a lid action: ${1-<none>}" ;;
    esac
    install -dm755 /etc/systemd/logind.conf.d
    cat > /etc/systemd/logind.conf.d/90-c7shell.conf <<EOF
# Written by the c7shell settings app (system -> power). Edit it there, or
# delete this file to fall back to whatever /etc/systemd/logind.conf says.
[Login]
HandleLidSwitch=$action
HandleLidSwitchExternalPower=$action
EOF
    # The documented way to make logind re-read its config without dropping
    # sessions. `systemctl restart systemd-logind` would take the seat with it.
    exec systemctl kill -s HUP --kill-whom=main systemd-logind.service
    ;;

  *)
    die "unknown verb: ${verb:-<none>}"
    ;;
esac
