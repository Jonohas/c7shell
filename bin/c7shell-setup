#!/usr/bin/env bash
# Copy the c7shell configs from /usr/share into the user's ~/.config.
# Neither hyprland nor quickshell reads config from /usr/share or
# XDG_CONFIG_DIRS, so this copy is what makes an installed package usable.
set -euo pipefail

share=${C7SHELL_SHARE:-/usr/share/c7shell}
conf=${XDG_CONFIG_HOME:-$HOME/.config}
state=${C7SHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/c7shell}
parts=(hypr quickshell/c7shell xdg-desktop-portal)
force=0
dry=0

usage() {
  cat <<USAGE
usage: c7shell-setup [--force] [--dry-run]

  --force     replace existing ~/.config/hypr, ~/.config/quickshell/c7shell and
              ~/.config/xdg-desktop-portal, keeping a timestamped .bak-<stamp>
              copy of each
  --dry-run   print what would happen and change nothing

env: C7SHELL_SHARE (default /usr/share/c7shell)
     XDG_CONFIG_HOME  (default \$HOME/.config)
     C7SHELL_STATE    (default \$XDG_STATE_HOME/c7shell)

exit: 0 all parts installed, 3 nothing done because a target already exists
USAGE
}

while (($#)); do
  case $1 in
    --force) force=1 ;;
    --dry-run|-n) dry=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'c7shell-setup: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ((EUID == 0)) && [[ -z ${C7SHELL_ALLOW_ROOT:-} ]]; then
  echo "c7shell-setup: run this as your own user, not root" >&2
  exit 2
fi

for part in "${parts[@]}"; do
  [[ -d $share/$part ]] || { printf 'c7shell-setup: missing %s -- is the package installed?\n' "$share/$part" >&2; exit 1; }
done

run() { if ((dry)); then printf '  would: %s\n' "$*"; else "$@"; fi; }

stamp=$(date +%Y%m%d%H%M%S)
skipped=0
installed=0

for part in "${parts[@]}"; do
  dst=$conf/$part
  if [[ -e $dst ]]; then
    if ((force)); then
      printf 'backing up %s -> %s.bak-%s\n' "$dst" "$dst" "$stamp"
      run mv -- "$dst" "$dst.bak-$stamp"
    else
      printf '%s already exists, left alone (rerun with --force to replace it)\n' "$dst" >&2
      skipped=1
      continue
    fi
  fi
  printf 'installing %s -> %s\n' "$share/$part" "$dst"
  run mkdir -p -- "$(dirname -- "$dst")"
  run cp -a -- "$share/$part" "$dst"
  installed=1
done

# xdph has no variable expansion, so the shipped picker path is a $HOME
# placeholder that only becomes usable once it names a real directory.
xdph=$conf/hypr/xdph.conf
if [[ -f $xdph ]] && grep -q '\$HOME/\.config/quickshell' "$xdph"; then
  run sed -i "s#\$HOME/.config/quickshell#$conf/quickshell#" "$xdph"
fi

# The palette and the preferred colour scheme live in appearance.json; Qt and
# KDE apps read kdeglobals, and apps that detect a dark desktop read GSettings
# through the portal. The settings app exports to both, but only when something
# changes -- so on a fresh install nothing has exported yet, dolphin comes up
# stock and every detecting app comes up light. Seed it once here. Non-fatal: it
# is cosmetic, and it needs python3 plus the copy that was just made.
exporter=$conf/quickshell/c7shell/scripts/c7shell-theme-export.py
if [[ -f $exporter ]] && command -v python3 >/dev/null; then
  if ((dry)); then
    printf '  would: python3 %s   (seed ~/.config/kdeglobals and the color-scheme preference)\n' "$exporter"
  else
    printf 'exporting the palette to %s/kdeglobals, and the color-scheme preference\n' "$conf"
    python3 "$exporter" || printf 'c7shell-setup: the appearance export failed; Qt apps keep their own colours and apps that detect a theme stay light\n' >&2
  fi
fi

if ((installed == 0 && skipped)); then
  exit 3
fi

# Record the hash of every file as installed. c7shell-upgrade compares against
# this to tell "you edited it" from "it is just an old copy" -- without it, a
# later upgrade has to assume every difference is a local edit and can only
# park new versions as .new files.
if ((dry == 0)); then
  mkdir -p -- "$state"
  : > "$state/manifest"
  for part in "${parts[@]}"; do
    [[ -d $conf/$part ]] || continue
    while read -r f; do
      printf '%s\t%s\n' "${f#"$conf/"}" "$(sha256sum -- "$f" | cut -d' ' -f1)"
    done < <(find "$conf/$part" -type f ! -name '*.new' | sort)
  done >> "$state/manifest"
fi

cat <<'MSG'

Done. Log out and pick the "c7shell" session in your display manager, or
start it from a TTY with: start-hyprland

Notes:
  - The shell is the named quickshell config "c7shell": it runs as
    `qs -c c7shell` and leaves any other ~/.config/quickshell config alone.
  - ~/.config/hypr/appearance.json is written by the settings app on first
    change; until then the defaults in conf/appearance.lua apply.
  - Logitech thumb-button gestures expect ~/.config/solaar/rules.yaml, which
    is yours to write; the autostart entry is harmless without it.
MSG
