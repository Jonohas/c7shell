<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>c7shell</vendor>
  <vendor_url>https://github.com/Jonohas/c7shell</vendor_url>

  <!-- Without an action of our own, pkexec falls back to
       org.freedesktop.policykit.exec, whose dialog names the binary rather
       than the task. This one says what is about to happen. The program it
       authorises takes a fixed verb, never a command line - see bin/c7up-root.

       auth_admin_keep is for the clicks *after* a run: resolving a pacnew,
       restarting a service, removing orphans. It is deliberately not what
       keeps a run to one prompt - polkit keeps an admin authorisation for
       five minutes and a full update is routinely longer, so the run holds a
       single authorised root session open instead (c7up-root's `session`
       verb). -->
  <action id="io.crimson7.c7shell.update">
    <description>Apply system updates</description>
    <message>Authentication is required to apply system updates</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/c7shell/c7up-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <!-- The power page's three privileged writes: the charge limit, the lid
       action, and enabling tuned.service. Same shape as the update action -
       one program, a fixed verb, named here by absolute path. auth_admin_keep
       so dragging the charge-limit slider does not prompt on every step. -->
  <action id="io.crimson7.c7shell.power">
    <description>Change system power settings</description>
    <message>Authentication is required to change system power settings</message>
    <icon_name>battery</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/c7shell/c7power-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
