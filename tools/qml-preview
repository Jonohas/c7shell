#!/usr/bin/env python3
"""Run one component in a window of its own, without starting the shell.

  tools/qml-preview --list
  tools/qml-preview qs.Common/BatteryGlyph --zoom 8
  tools/qml-preview qs.Modules.Settings/SettingsWindow --show appearance

Quickshell has no component preview, and the obvious substitutes do not work
here. A Loader pointed at Common/BatteryGlyph.qml loads the file but its sibling
`Icon` stops resolving, and Qt.createQmlObject("import qs.Common; ...") fails
with `module "qs.Common" is not installed`. Both have the same cause: quickshell
generates a directory's qmldir only for directories the entry file references
*statically*, so anything named by a string at runtime reaches a module that was
never built.

So the target has to be named in source. This generates PreviewRegistry.qml next
to shell.qml -- every component in the tree, each module under its own alias so
two modules cannot collide on a type name -- and preview.qml picks one out of it
by the name in QS_PREVIEW. The registry is regenerated on every run: a stale one
fails as "unknown target", which reads like a typo in the argument.

preview.qml has to sit at the config root and nowhere else. `qs` is not a real
module, it is whatever directory quickshell registers under the file `-p` points
at, so from a subdirectory every `qs.*` import in it resolves against that
subdirectory and fails.
"""

import argparse
import os
import pathlib
import re
import subprocess
import sys

# Entry points, and the registry itself. Importing these back into the registry
# would be a cycle, and none of them is a component you would preview.
NOT_COMPONENTS = {"shell.qml", "preview.qml", "PreviewRegistry.qml"}


def default_root() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parent.parent / "quickshell" / "c7shell"


def module_of(root: pathlib.Path, qml: pathlib.Path) -> str:
    rel = qml.parent.relative_to(root)
    return "qs" if rel == pathlib.Path(".") else "qs." + ".".join(rel.parts)


def collect(root: pathlib.Path) -> dict[str, list[str]]:
    modules: dict[str, list[str]] = {}
    for qml in sorted(root.rglob("*.qml")):
        rel = qml.relative_to(root)
        if qml.name in NOT_COMPONENTS or any(p.startswith(".") for p in rel.parts):
            continue
        # A lowercase name cannot be referenced as a type from QML at all.
        if not qml.stem[0].isupper():
            continue
        # A singleton is reached as `Theme.accent` and never instantiated;
        # `Theme {}` is a hard error, so it cannot go in the registry.
        if re.search(r"^\s*pragma\s+Singleton", qml.read_text(), re.M):
            continue
        modules.setdefault(module_of(root, qml), []).append(qml.stem)
    return modules


def generate(root: pathlib.Path) -> list[str]:
    modules = collect(root)
    if not modules:
        sys.exit(f"no components under {root}")

    aliases = {mod: f"M{i}" for i, mod in enumerate(sorted(modules))}
    targets, properties, lines = [], [], [
        "// GENERATED by tools/qml-preview -- do not edit, do not commit.",
        "import QtQuick",
    ]
    lines += [f"import {mod} as {alias}" for mod, alias in sorted(aliases.items())]
    lines += ["", "QtObject {", "  readonly property var components: ({"]

    for mod in sorted(modules):
        for name in sorted(modules[mod]):
            target = f"{mod}/{name}"
            prop = "c_" + re.sub(r"\W", "_", target)
            targets.append(target)
            lines.append(f'    "{target}": {prop},')
            properties.append(f"  readonly property Component {prop}: "
                              f"Component {{ {aliases[mod]}.{name} {{}} }}")

    lines += ["  })", ""] + properties + ["}"]
    (root / "PreviewRegistry.qml").write_text("\n".join(lines) + "\n")
    return targets


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target", nargs="?", help="module/Type, e.g. qs.Common/BatteryGlyph")
    ap.add_argument("--list", action="store_true", help="print every target and exit")
    ap.add_argument("--zoom", type=float, default=1.0,
                    help="scale the component; bar glyphs are ~20px and need it")
    ap.add_argument("--show", default="",
                    help="argument for the component's show(), for one that opens itself")
    ap.add_argument("--root", type=pathlib.Path, default=default_root(),
                    help="quickshell config root (default: this checkout's)")
    args = ap.parse_args()

    root = args.root.resolve()
    targets = generate(root)

    if args.list:
        print("\n".join(targets))
        return
    if not args.target:
        ap.error("give a target, or --list to see them")
    if args.target not in targets:
        sys.exit(f"unknown target {args.target!r} -- try --list")

    os.environ["QS_PREVIEW"] = args.target
    os.environ["QS_PREVIEW_ZOOM"] = str(args.zoom)
    os.environ["QS_PREVIEW_SHOW"] = args.show
    raise SystemExit(subprocess.call(["quickshell", "-p", str(root / "preview.qml")]))


if __name__ == "__main__":
    main()
